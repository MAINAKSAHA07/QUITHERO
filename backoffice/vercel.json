{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/pocketbase/:path*",
      "destination": "/api/pocketbase/:path*"
    },
    {
      "source": "/api/push/:path*",
      "destination": "https://app.smono.app/api/push/:path*"
    },
    {
      "source": "/api/support/:path*",
      "destination": "https://app.smono.app/api/support/:path*"
    },
    {
      "source": "/api/coach/:path*",
      "destination": "https://app.smono.app/api/coach/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://app.smono.app/api/admin/:path*"
    },
    {
      "source": "/api/email/:path*",
      "destination": "https://app.smono.app/api/email/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
